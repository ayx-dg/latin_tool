# 复制后填入真实值，切勿提交 .env 本身
GEMINI_API_KEY=
TURNSTILE_SECRET=

# 标注模型（二选一）
# GEMINI_API_KEY=<Google AI Studio 的 key>
# 或任何 OpenAI 兼容端点：
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=

# 部署用（本地开发可留空）
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
ALLOWED_HOSTS=.onrender.com
# Supabase: Project Settings -> Database -> Connection string (URI, 建议用 6543 pooler)
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
# 可选：Upstash 免费 Redis
REDIS_URL=
